{
  "name": "solspace/craft-dark-mode",
  "description": "Give Craft’s control panel a darker look, with support for your favorite plugins.",
  "type": "craft-plugin",
  "version": "1.0.0",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "Solspace\\DarkMode\\": "src/"
    }
  },
  "extra": {
    "schemaVersion": "1.0.0",
    "name": "Dark Mode",
    "handle": "dark-mode",
    "class": "Solspace\\DarkMode\\Plugin",
    "developer": "Solspace",
    "developerUrl": "https://solspace.com",
    "documentationUrl": "https://docs.solspace.com/craft/dark-mode/v1/"
  },
  "homepage": "https://solspace.com",
  "keywords": [
    "craft",
    "craftcms",
    "dark-mode",
    "control-panel",
    "appearance"
  ],
  "authors": [
    {
      "name": "Solspace",
      "homepage": "https://solspace.com"
    }
  ],
  "support": {
    "source": "https://github.com/solspace/craft-dark-mode",
    "issues": "https://github.com/solspace/craft-dark-mode/issues",
    "docs": "https://docs.solspace.com/craft/dark-mode/v1/"
  }
}
